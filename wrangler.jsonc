{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"tg-alerts",
  "main":"cloudflare/worker.mjs",
  "compatibility_date":"2026-10-22",
  "compatibility_flags":["nodejs_compat","global_fetch_strictly_public"],
  "workers_dev":true,
  "preview_urls":false,
  "keep_vars":true,
  "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":["/api/*","/admin/*","/telegram/*","/health","/setup","/setup.html"]},
  "durable_objects":{"bindings":[{"name":"ALERTS","class_name":"AlertsEngine"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["AlertsEngine"]}],
  "triggers":{"crons":["*/5 * * * *"]},
  "vars":{
    "PRICE_SOURCE":"oanda",
    "OANDA_ENV":"practice",
    "OANDA_SIDE":"mid",
    "CAPITAL_ENV":"live",
    "REQUIRE_ACCESS":"true",
    "AUTH_API_URL":"https://retocker-access.retocker.workers.dev",
    "WEBAPP_URL":"https://tg-alerts.retocker.workers.dev",
    "STREAM_WINDOW_SECONDS":"540",
    "NEWS_MIRROR_URL":"https://fxfactory.netlify.app/api/calendar",
    "ADMIN_CHAT_ID":"1011596614"
  },
  "observability":{"enabled":true}
}
